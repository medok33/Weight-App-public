generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User {
  id String @id @default(uuid()) @db.Uuid
  email String? @unique
  username String? @unique
  accountRole String @default("USER")
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  identities AuthIdentity[]
  sessions Session[]
  profile UserProfile?
  workoutProfile WorkoutProfile?
  workoutPlanDayOverrides WorkoutPlanDayOverride[]
  workoutSessions WorkoutSession[]
  workoutAdaptations WorkoutAdaptation[]
  workoutAdaptationCommands WorkoutAdaptationCommand[]
  eligibilityAssessments EligibilityAssessment[]
  shoppingLists ShoppingList[]
  aiConversations AIConversation[]
  aiUsageLogs AIUsageLog[]
  aiMessageFeedback AIMessageFeedback[]
  userSubscription UserSubscription?
  anonymousMigrations AnonymousMigration[] @relation("MigrationTarget")
  ownerMfaCredentials OwnerMfaCredential[]
  ownerMfaRecoveryCodes OwnerMfaRecoveryCode[]
  mfaPreAuthChallenges MfaPreAuthChallenge[]
  ownerMfaReplayStates OwnerMfaReplayState[]
  ownerMfaEnrollmentDrafts OwnerMfaEnrollmentDraft[]
  ownerAuditEvents OwnerAuditEvent[]
  productOffers ProductOffer[]
  payments Payment[]
  entitlements Entitlement[]
  exportJobs ExportJob[]
  shareLinks ShareLink[]
  aiControls AIControl[]
  featureFlags FeatureFlag[]
  mealCompletions MealCompletion[]
  activitySyncClients ActivitySyncClient[]
  activityDailySnapshots ActivityDailySnapshot[]
  activitySyncOperations ActivitySyncOperation[]
  activitySyncRateBuckets ActivitySyncRateBucket[]
  activityProviderConnections ActivityProviderConnection[]
  progressEntries ProgressEntry[]
  pantries Pantry[]
  ownedFamilies Family[] @relation("FamilyOwner")
  familyMemberships FamilyMember[]
  sentFamilyInvitations FamilyInvitation[] @relation("FamilyInviter")
  acceptedFamilyInvitations FamilyInvitation[] @relation("FamilyInviteAcceptor")
  sharedDishes SharedDish[]
  sharedDishPortions SharedDishPortion[]
  notificationPreference NotificationPreference?
  notifications Notification[]
  healthPlatformConsents HealthPlatformConsent[]
  engagementState EngagementState?
  integrationConnections IntegrationConnection[]
  regeneratedFamilyShoppingLists FamilyShoppingList[]
  planRevisions PlanRevision[]
}
model AuthIdentity {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  provider String
  providerSubject String
  credentialHash String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerSubject])
  @@index([userId])
}
model UserSubscription {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  tier String
  status String @default("active")
  startsAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model AnonymousMigration {
  id String @id @default(uuid()) @db.Uuid
  anonymousUserId String @unique @db.Uuid
  targetUserId String @db.Uuid
  migratedAt DateTime @default(now())
  targetUser User @relation("MigrationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  mfaVerifiedAt DateTime?
  recentOwnerReauthAt DateTime?
  createdAt DateTime @default(now())
  role String @default("USER")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model OwnerMfaCredential {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  method String @default("TOTP")
  status String @default("ACTIVE")
  encryptedSecret Json
  confirmedAt DateTime
  disabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes OwnerMfaRecoveryCode[]
  @@index([userId, status])
}

model OwnerMfaEnrollmentDraft {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  encryptedSecret Json
  expiresAt DateTime
  confirmedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model OwnerMfaRecoveryCode {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  credentialId String @db.Uuid
  codeHash String
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential OwnerMfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  @@unique([credentialId, codeHash])
  @@index([userId, usedAt])
}

model MfaPreAuthChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  challengeHash String @unique
  accountHash String
  sourceIpHash String
  accountIpHash String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([challengeHash, expiresAt])
}

model OwnerMfaReplayState {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  timeStep BigInt
  acceptedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, timeStep])
  @@index([acceptedAt])
}

model UserProfile { id String @id @default(uuid()) @db.Uuid; userId String @unique @db.Uuid; displayName String?; ageYears Int?; ageBand String?; heightCm Int?; weightKg Decimal? @db.Decimal(8,2); activityLevel String?; locale String @default("ru"); timezone String?; trainingLevel String?; workoutsPerWeek Int?; dietaryPreferences String?; foodRestrictions String?; availableEquipment String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields: [userId], references: [id], onDelete: Cascade); goals UserGoal[] }
model UserGoal { id String @id @default(uuid()) @db.Uuid; profileId String @db.Uuid; kind String; target Decimal? @db.Decimal(8,2); unit String?; targetDate DateTime? @db.Date; createdAt DateTime @default(now()); profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade); @@index([profileId]) }
model PolicyVersion { id String @id @default(uuid()) @db.Uuid; kind String; version String; effectiveAt DateTime; checksum String; createdAt DateTime @default(now()); @@unique([kind, version]) }
model AIConversation { id String @id @default(uuid()) @db.Uuid; userId String @db.Uuid; title String?; createdAt DateTime @default(now()); messages AIMessage[]; usageLogs AIUsageLog[]; user User @relation(fields: [userId], references: [id], onDelete: Cascade); @@index([userId, createdAt]) }
model AIMessage { id String @id @default(uuid()) @db.Uuid; conversationId String @db.Uuid; role String; content String; createdAt DateTime @default(now()); conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade); feedback AIMessageFeedback[]; @@index([conversationId, createdAt]) }
model AIMessageFeedback { id String @id @default(uuid()) @db.Uuid; userId String @db.Uuid; messageId String @db.Uuid; rating String; createdAt DateTime @default(now()); user User @relation(fields: [userId], references: [id], onDelete: Cascade); message AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade); @@unique([userId, messageId]); @@index([messageId]); @@index([createdAt]) }
model AIUsageLog {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  conversationId String? @db.Uuid
  providerId String
  model String
  promptTokens Int @default(0)
  completionTokens Int @default(0)
  topic String?
  errorCode String?
  tier String?
  thinkingEnabled Boolean @default(false)
  totalTokens Int @default(0)
  estimatedCost Decimal @default(0) @db.Decimal(12, 6)
  latencyMs Int @default(0)
  success Boolean @default(true)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}
model Role { id String @id @default(uuid()) @db.Uuid; name String @unique; permissions Permission[] }
model Permission { id String @id @default(uuid()) @db.Uuid; roleId String @db.Uuid; action String; role Role @relation(fields: [roleId], references: [id], onDelete: Cascade); @@unique([roleId, action]) }

model OwnerAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  action String
  metadata Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorUserId String? @db.Uuid
  action String
  entityType String?
  entityId String?
  requestId String?
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action])
}

model AuthThrottleBucket {
  id String @id @default(uuid()) @db.Uuid
  action String
  subjectType String
  subjectHash String
  windowStartedAt DateTime @default(now())
  failureCount Int @default(0)
  blockedUntil DateTime?
  lastFailureAt DateTime?
  successClearedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([action, subjectType, subjectHash], map: "AuthThrottleBucket_action_subject_unique")
  @@index([action, subjectType, subjectHash, blockedUntil])
  @@index([blockedUntil, windowStartedAt])
}

model AuthAccountLockout {
  id String @id @default(uuid()) @db.Uuid
  accountHash String @unique
  failureCount Int @default(0)
  lockedUntil DateTime?
  lastFailureAt DateTime?
  recoveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([lockedUntil])
  @@index([updatedAt])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  targetUserId String? @db.Uuid
  action String
  entityType String?
  entityId String?
  requestId String?
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  @@index([ownerUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action])
}

model ProductOffer {
  key String @id
  name String
  amountMinor Int
  currency String
  interval String
  active Boolean @default(true)
  metadata Json
  updatedBy String? @db.Uuid
  updatedAt DateTime @updatedAt
  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
  payments Payment[]
  @@index([active])
}

model AIControl {
  id Int @id @default(1)
  enabled Boolean @default(true)
  updatedBy String @db.Uuid
  updatedAt DateTime @default(now())
  updater User @relation(fields: [updatedBy], references: [id])
}

model FeatureFlag {
  key String @id
  enabled Boolean @default(false)
  updatedBy String @db.Uuid
  updatedAt DateTime @default(now())
  updater User @relation(fields: [updatedBy], references: [id])
  @@index([enabled])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  offerKey String?
  provider String
  providerPaymentId String?
  status String
  amountMinor Int
  currency String
  metadata Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer ProductOffer? @relation(fields: [offerKey], references: [key], onDelete: SetNull)
  events PaymentEvent[]
  refunds Refund[]
  entitlements Entitlement[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@unique([provider, providerPaymentId])
}

model Entitlement {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  key String
  status String @default("active")
  startsAt DateTime @default(now())
  endsAt DateTime?
  sourcePaymentId String? @db.Uuid
  metadata Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcePayment Payment? @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)
  @@unique([userId, key])
  @@index([userId, status, endsAt])
  @@index([sourcePaymentId])
}

model PaymentEvent {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @db.Uuid
  type String
  providerEventId String?
  payload Json
  createdAt DateTime @default(now())
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@index([paymentId, createdAt])
  @@unique([provider, providerEventId])
  provider String
}

model Refund {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @db.Uuid
  amountMinor Int
  currency String
  status String
  reason String?
  providerRefundId String?
  metadata Json
  requestedByUserId String? @db.Uuid
  decidedByUserId String? @db.Uuid
  decidedAt DateTime?
  decisionNote String?
  idempotencyKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
  @@unique([providerRefundId])
  @@unique([idempotencyKey])
}

model ExportJob {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  type String
  status String
  idempotencyKey String @unique
  payload Json
  result Json?
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinks ShareLink[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ShareLink {
  id String @id @default(uuid()) @db.Uuid
  token String @unique
  exportJobId String @db.Uuid
  userId String @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  exportJob ExportJob @relation(fields: [exportJobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([exportJobId])
  @@index([expiresAt])
}

model EligibilityAssessment {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  answers Json
  outcome String
  policyVersion String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model Product {
  id                        String                    @id @default(uuid()) @db.Uuid
  canonicalName             String                    @unique
  productKey                String?                   @unique
  name                      String?
  category                  String?
  categoryId                String?                   @db.Uuid
  form                      String?
  fatPercent                Decimal?                  @db.Decimal(8, 4)
  ediblePartPercent         Decimal?                  @db.Decimal(8, 4)
  density                   Decimal?                  @db.Decimal(12, 6)
  averagePieceWeightGrams   Decimal?                  @db.Decimal(12, 4)
  yieldCoefficient          Decimal?                  @db.Decimal(8, 4)
  defaultUnit               String?
  unit                      String
  weight                    String?
  caloriesPer100g           Decimal                   @db.Decimal(8, 2)
  proteinPer100g            Decimal                   @db.Decimal(8, 2)
  fatPer100g                Decimal?                  @db.Decimal(8, 2)
  carbsPer100g              Decimal?                  @db.Decimal(8, 2)
  packageSize               Decimal?                  @db.Decimal(10, 2)
  packageUnit               String?
  currentNutritionVersionId String?                   @db.Uuid
  status                    String                    @default("ACTIVE")
  canonicalProductId        String?                   @db.Uuid
  mergedAt                  DateTime?
  mergedBy                  String?                   @db.Uuid
  reviewStatus              String                    @default("NONE")
  reviewNote                String?
  rowVersion                Int                       @default(1)
  seedDatasetVersion        String?
  seedProvenance            Json?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @default(now())
  categoryRef               ProductCategory?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentNutritionVersion   ProductNutritionVersion?  @relation("ProductCurrentNutrition", fields: [currentNutritionVersionId], references: [id], onDelete: SetNull)
  nutritionVersions         ProductNutritionVersion[] @relation("ProductNutritionHistory")
  aliases                   ProductAlias[]
  ingredients               RecipeIngredient[]
  recipeFamilies            RecipeFamily[]
  recipeProductDependencies RecipeProductDependency[]
  recipeRevalidationTasks   RecipeRevalidationTask[]
  coverageSlots             RecipeCoverageSlot[]
  productAllergens          ProductAllergen[]
  productDietaryTags        ProductDietaryTag[]
  culinaryRoles             ProductCulinaryRole[]
  substitutionsAsSource     ProductSubstitution[] @relation("SubstitutionSource")
  substitutionsAsReplacement ProductSubstitution[] @relation("SubstitutionReplacement")
  retailProducts            RetailProduct[]
  mergeTarget               Product?                  @relation("ProductMergeLineage", fields: [canonicalProductId], references: [id], onDelete: Restrict)
  mergedSources             Product[]                 @relation("ProductMergeLineage")
  reviewDecisions           ProductReviewDecision[]
  @@index([categoryId])
  @@index([form])
  @@index([status, updatedAt])
  @@index([canonicalProductId])
  @@index([reviewStatus])
  @@index([seedDatasetVersion])
}

model ProductReviewDecision {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  queueCode    String
  decision    String   @default("RESOLVED")
  note        String?
  actorUserId String?  @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([productId, createdAt])
  @@index([queueCode, createdAt])
}

model CulinaryRole {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  name        String
  description String?
  status      String               @default("ACTIVE")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now())
  products    ProductCulinaryRole[]
  substitutions ProductSubstitution[]
}

model ProductCulinaryRole {
  id             String       @id @default(uuid()) @db.Uuid
  productId      String       @db.Uuid
  culinaryRoleId String       @db.Uuid
  isPrimary      Boolean      @default(false)
  source         String       @default("HEURISTIC")
  confidence     Decimal      @default(0.50) @db.Decimal(5, 4)
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  culinaryRole   CulinaryRole @relation(fields: [culinaryRoleId], references: [id], onDelete: Restrict)
  @@unique([productId, culinaryRoleId])
  @@index([culinaryRoleId])
}

model CookingMethod {
  code      String   @id
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
}

model ProductSubstitution {
  id                   String        @id @default(uuid()) @db.Uuid
  sourceProductId      String        @db.Uuid
  replacementProductId String        @db.Uuid
  culinaryRoleId       String?       @db.Uuid
  replacementRatio     Decimal       @db.Decimal(12, 6)
  replacementRatioMin  Decimal       @db.Decimal(12, 6)
  replacementRatioMax  Decimal       @db.Decimal(12, 6)
  nutritionImpact      String        @default("UNKNOWN")
  textureImpact        String        @default("UNKNOWN")
  supportedMethods     String[]      @default([])
  status               String        @default("ACTIVE")
  source               String        @default("MANUAL")
  confidence           Decimal       @default(1.0) @db.Decimal(5, 4)
  reviewedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now())
  sourceProduct        Product       @relation("SubstitutionSource", fields: [sourceProductId], references: [id], onDelete: Restrict)
  replacementProduct   Product       @relation("SubstitutionReplacement", fields: [replacementProductId], references: [id], onDelete: Restrict)
  culinaryRole         CulinaryRole? @relation(fields: [culinaryRoleId], references: [id], onDelete: Restrict)
  @@index([sourceProductId, status])
  @@index([replacementProductId])
}

model RetailProduct {
  id                  String             @id @default(uuid()) @db.Uuid
  retailerId          String             @db.Uuid
  canonicalProductId  String?            @db.Uuid
  externalSku         String?
  title               String
  brand               String?
  packageWeight       Decimal?           @db.Decimal(12, 4)
  packageUnit         String?
  packageQuantity     Decimal?           @db.Decimal(12, 4)
  barcode             String?
  status              String             @default("ACTIVE")
  mappingStatus       String             @default("NEEDS_PRODUCT_MAPPING")
  source              String             @default("LEGACY_BACKFILL")
  externalProductId   String?            @db.Uuid
  lastMatchedAt       DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now())
  retailer            Retailer           @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  canonicalProduct    Product?           @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict)
  externalProduct     ExternalProduct?   @relation(fields: [externalProductId], references: [id], onDelete: SetNull)
  observations        PriceObservation[]
  @@index([canonicalProductId])
  @@index([retailerId, status])
}

model ProductCategory {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique
  name      String
  parentId  String?           @db.Uuid
  position  Int               @default(0)
  status    String            @default("ACTIVE")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now())
  parent    ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  ProductCategory[] @relation("ProductCategoryTree")
  products  Product[]
  @@index([parentId])
  @@index([status, position, code])
}

model ProductAlias {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @db.Uuid
  alias           String
  normalizedAlias String?
  source          String   @default("LEGACY_BACKFILL")
  confidence      Decimal  @default(1.0) @db.Decimal(5, 4)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
  @@index([normalizedAlias])
}

model ProductNutritionVersion {
  id             String    @id @default(uuid()) @db.Uuid
  productId      String    @db.Uuid
  version        Int
  calories       Decimal   @db.Decimal(10, 2)
  protein        Decimal   @db.Decimal(10, 2)
  fat            Decimal   @db.Decimal(10, 2)
  carbohydrate   Decimal   @db.Decimal(10, 2)
  fiber          Decimal?  @db.Decimal(10, 2)
  sodium         Decimal?  @db.Decimal(10, 2)
  source         String
  validFrom      DateTime  @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  createdBy      String?   @db.Uuid
  product        Product   @relation("ProductNutritionHistory", fields: [productId], references: [id], onDelete: Restrict)
  currentFor     Product[] @relation("ProductCurrentNutrition")
  @@unique([productId, version])
  @@index([productId, validFrom(sort: Desc)])
}

model Allergen {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  name      String
  status    String           @default("ACTIVE")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now())
  products  ProductAllergen[]
}

model DietaryTag {
  id        String              @id @default(uuid()) @db.Uuid
  code      String              @unique
  name      String
  status    String              @default("ACTIVE")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @default(now())
  products  ProductDietaryTag[]
}

model ProductAllergen {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  allergenId String   @db.Uuid
  presence   String   @default("CONTAINS")
  source     String   @default("LEGACY_BACKFILL")
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)
  @@unique([productId, allergenId])
  @@index([allergenId])
}

model ProductDietaryTag {
  id           String     @id @default(uuid()) @db.Uuid
  productId    String     @db.Uuid
  dietaryTagId String     @db.Uuid
  source       String     @default("LEGACY_BACKFILL")
  createdAt    DateTime   @default(now())
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict)
  @@unique([productId, dietaryTagId])
  @@index([dietaryTagId])
}

