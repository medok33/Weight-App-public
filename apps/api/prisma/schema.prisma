  syncOperationId    String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncClient         ActivitySyncClient @relation(fields: [syncClientId], references: [id], onDelete: Cascade)
  @@index([userId, localDate])
  @@index([syncClientId, receivedAt])
}

model ActivitySyncOperation {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  sourceType       String
  syncClientId     String   @db.Uuid
  operationId      String
  sequence         BigInt
  payloadChecksum  String
  status           String
  responseSnapshot Json
  receivedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncClient       ActivitySyncClient @relation(fields: [syncClientId], references: [id], onDelete: Cascade)
  @@unique([userId, sourceType, syncClientId, operationId])
  @@index([userId, receivedAt])
}

model ActivitySyncRateBucket {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  windowStartedAt DateTime  @default(now())
  requestCount    Int       @default(0)
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([blockedUntil, windowStartedAt])
}

/// Durable exactly-once ledger for the canonical custom SQL migration runner (Package A).
model SchemaMigrationLedger {
  id             String   @id @default(uuid()) @db.Uuid
  migrationName  String   @unique
  checksum       String
  appliedAt      DateTime @default(now())
  durationMs     Int
  result         String
  runnerVersion  String   @default("1")

  @@index([appliedAt])
  @@map("SchemaMigrationLedger")
}

/// Content catalog seed ledger (not schema migrations). RP2-01C2A STEP_201.
model CatalogSeedBatch {
  id             String   @id @default(uuid()) @db.Uuid
  datasetVersion String   @unique
  checksum       String
  productCount   Int
  status         String
  appliedAt      DateTime @default(now())
  durationMs     Int      @default(0)
  resultJson     Json     @default("{}")

  @@index([appliedAt])
}
