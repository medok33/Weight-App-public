{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --module node16 --moduleResolution node16 --target es2022 --types node --experimentalDecorators --emitDecoratorMetadata --outDir dist src/main.ts",
    "dev": "tsx watch src/main.ts",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "typecheck": "tsc --noEmit -p tsconfig.lint.json",
    "test": "vitest run --passWithNoTests --pool=forks --fileParallelism=false --exclude test/database/owner-mfa.persistence.spec.ts",
    "test:e2e": "vitest run --passWithNoTests --pool=forks --fileParallelism=false",
    "owner:bootstrap": "node scripts/bootstrap-owner.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "db:migrate:baseline": "node scripts/migrate.mjs --baseline",
    "db:check-migrations": "node scripts/check-migrations.mjs",
    "catalog:01b:check": "node scripts/generate-workout-catalog-01b.mjs --check",
    "workout-energy:content:check": "node scripts/workout-energy-content-check.mjs",
    "workout-energy:content:load": "node scripts/workout-energy-content-load.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "pdfkit": "^0.19.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "26.1.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.15.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
