# API environment (copy to .env — never commit secrets)

NODE_ENV=development
# LOCAL | STAGING | PRODUCTION — drives CORS/cookie fail-closed rules (ARCH-SEC-02A)
APP_ENV=LOCAL
PORT=3001
DATABASE_URL=postgresql://weight_app:weight_app_local@localhost:5432/weight_app
REDIS_URL=redis://localhost:6379

# Comma-separated browser origins for CORS + CSRF checks (no wildcards).
# LOCAL defaults to http://localhost:3000 when unset.
# STAGING/PRODUCTION require explicit HTTPS origins (no localhost).
WEB_ALLOWED_ORIGINS=http://localhost:3000

# Session cookie policy (Secure defaults true for STAGING/PRODUCTION)
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_DOMAIN=

# Session secrets (set in production)
AUTH_SESSION_SECRET=
AUTH_REFRESH_SECRET=

# Owner bootstrap (local one-shot only; never put real values here)
OWNER_BOOTSTRAP_ENABLED=false
OWNER_BOOTSTRAP_USERNAME=
OWNER_BOOTSTRAP_PASSWORD=
OWNER_BOOTSTRAP_FORCE_PASSWORD=false

# Active AI backend: local | deepseek | openai | local-llm
AI_PROVIDER=local

# DeepSeek V4 (OpenAI-compatible) — never commit real keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FREE_MODEL=deepseek-v4-flash
DEEPSEEK_PREMIUM_MODEL=deepseek-v4-pro
DEEPSEEK_FREE_THINKING=disabled
DEEPSEEK_PREMIUM_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high

# Goal pace caution (kg change per week). Above this → AGGRESSIVE status in Goal Core.
GOAL_WEIGHT_CHANGE_CAUTION_KG_PER_WEEK=1

# Activity provider sync considered STALE after this many hours without success (ACTIVITY-01B).
# Integer 1..720. Unset → default 48. Invalid value fails API startup (no silent fallback).
ACTIVITY_SYNC_STALE_HOURS=48
# Sync + connect + disconnect share ActivitySyncRateBucket per authenticated USER (60 req / 60s default).
# ACTIVITY_SYNC_RATE_WINDOW_SECONDS=60
# ACTIVITY_SYNC_RATE_MAX_REQUESTS=60
# ACTIVITY_SYNC_RATE_BLOCK_SECONDS=60

# Plan revision confirmation token (HMAC). Prefer this over REVISION_TOKEN_SECRET.
# Never commit a real value. Required in production.
PLAN_REVISION_CONFIRMATION_SECRET=
REVISION_TOKEN_SECRET=

# Export / signed downloads (local object storage under apps/api/.data/exports by default)
EXPORT_STORAGE_ROOT=
EXPORT_SIGNING_SECRET=
PUBLIC_WEB_BASE_URL=http://localhost:3000

# OpenAI (AI Assistant chat — do not rename)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Exercise media image generation (WORKOUT-CATALOG-01C) — disabled by default
OPENAI_IMAGE_MODEL=
EXERCISE_MEDIA_GENERATION_ENABLED=false
EXERCISE_MEDIA_PROMPT_VERSION=exercise-media-v1

# Local LLM (Ollama / compatible server) — set LOCAL_LLM_BASE_URL to enable
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=llama3
