    "test:e2e:a11y": "playwright test e2e/ux-stab-01e-accessibility.spec.ts",
    "test:e2e:onboarding": "playwright test e2e/ux-stab-01f-onboarding.spec.ts",
    "test:e2e:dashboard": "playwright test e2e/ux-stab-01g-dashboard.spec.ts",
    "test:e2e:settings": "playwright test e2e/ux-stab-01h-account-settings.spec.ts",
    "test:e2e:workout-v2": "playwright test e2e/workout-v2-01a-initial-plan.spec.ts",
    "test:e2e:workout-v2-01b": "playwright test e2e/workout-v2-01b-hub.spec.ts",
    "test:e2e:workout-v2-01c": "playwright test e2e/workout-v2-01c-session.spec.ts e2e/workout-v2-01c-http.spec.ts",
    "test:e2e:workout-v2-01d": "playwright test e2e/workout-v2-01d-adaptations.spec.ts",
