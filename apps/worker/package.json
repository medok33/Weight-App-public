{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --module node16 --moduleResolution node16 --target es2022 --outDir dist src/main.ts",
    "dev": "tsx watch src/main.ts",
    "lint": "tsc --noEmit --module node16 --moduleResolution node16 --target es2022 --skipLibCheck src/main.ts",
    "typecheck": "tsc --noEmit --module node16 --moduleResolution node16 --target es2022 --skipLibCheck src/main.ts",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.15.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
