# Non-secret local defaults
NODE_ENV=development
APP_PORT=3001
DATABASE_URL=postgresql://weight_app:weight_app_local@localhost:5432/weight_app
OWNER_BOOTSTRAP_ENABLED=false
OWNER_BOOTSTRAP_USERNAME=
OWNER_BOOTSTRAP_PASSWORD=
OWNER_BOOTSTRAP_FORCE_PASSWORD=false
REDIS_URL=redis://localhost:6379

# Auth secrets: generate unique values locally; never commit them.
AUTH_SESSION_SECRET=
AUTH_REFRESH_SECRET=

# AI gateway
AI_PROVIDER=local
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FREE_MODEL=deepseek-v4-flash
DEEPSEEK_PREMIUM_MODEL=deepseek-v4-pro
DEEPSEEK_FREE_THINKING=disabled
DEEPSEEK_PREMIUM_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
# Legacy aliases (optional, retired)
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=llama3

# Optional providers
EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
PAYMENT_PROVIDER=
OTEL_EXPORTER_OTLP_ENDPOINT=
BACKUP_S3_ENDPOINT=
