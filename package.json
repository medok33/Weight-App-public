{
  "name": "weight-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "node scripts/verify/verify-all.mjs",
    "verify:disposable": "node scripts/verify/disposable-runtime.mjs full",
    "verify:disposable:guard": "node scripts/verify/disposable-runtime.mjs guard-test",
    "verify:disposable:diagnostics": "node scripts/verify/disposable-runtime.mjs diagnostics",
    "ui:check-ru": "node scripts/ui/check-ru.mjs",
    "verify:step": "node scripts/verify/verify-step.mjs",
    "db:migrate": "node apps/api/scripts/migrate.mjs",
    "db:migrate:status": "node apps/api/scripts/migrate.mjs --status",
    "db:migrate:baseline": "node apps/api/scripts/migrate.mjs --baseline",
    "db:check-migrations": "node apps/api/scripts/check-migrations.mjs",
    "db:verify-historical": "node apps/api/scripts/verify-historical-upgrades.mjs",
    "docker:build": "node scripts/deploy/build-images.mjs",
    "docker:build:no-cache": "node scripts/deploy/build-images.mjs --no-cache",
    "docker:validate:prod-like": "node scripts/deploy/validate-prod-like.mjs",
    "docker:validate:compose": "node scripts/deploy/validate-compose-environments.mjs",
    "ci:validate-workflows": "node scripts/ci/validate-workflows.mjs",
    "test:e2e:runtime-smoke": "pnpm --dir apps/web test:e2e:runtime-smoke",
    "test:e2e:responsive": "pnpm --dir apps/web test:e2e:responsive",
    "test:e2e:a11y": "pnpm --dir apps/web test:e2e:a11y",
    "test:e2e:onboarding": "pnpm --dir apps/web test:e2e:onboarding",
    "test:e2e:dashboard": "pnpm --dir apps/web test:e2e:dashboard",
    "test:e2e:activity": "pnpm --dir apps/web test:e2e:activity",
    "owner:bootstrap": "node apps/api/scripts/bootstrap-owner.mjs",
    "catalog:seed:check": "pnpm --dir apps/api exec tsx scripts/catalog-seed.mjs check",
    "catalog:seed:dry-run": "pnpm --dir apps/api exec tsx scripts/catalog-seed.mjs dry-run",
    "catalog:seed:apply": "pnpm --dir apps/api exec tsx scripts/catalog-seed.mjs apply",
    "catalog:seed:report": "pnpm --dir apps/api exec tsx scripts/catalog-seed.mjs report",
    "data:recipe-classification:check": "pnpm --dir apps/api exec node scripts/recipe-data-classification.mjs check",
    "data:recipe-classification:dry-run": "pnpm --dir apps/api exec node scripts/recipe-data-classification.mjs dry-run",
    "data:recipe-classification:apply": "pnpm --dir apps/api exec node scripts/recipe-data-classification.mjs apply",
    "workout-energy:content:check": "pnpm --dir apps/api workout-energy:content:check",
    "workout-energy:content:check:strict": "pnpm --dir apps/api workout-energy:content:check -- --require-full-coverage",
    "workout-energy:content:load": "pnpm --dir apps/api workout-energy:content:load",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "turbo": "^2.5.6",
    "typescript-eslint": "8.46.3"
  }
}
