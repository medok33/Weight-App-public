# LOCAL template — copy to docker/env/local.env (gitignored). Placeholders only.
# Classification: public | server | secret | release-metadata

# public
APP_ENV=LOCAL
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
PUBLIC_WEB_BASE_URL=http://localhost:3000
WEB_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_DOMAIN=

# server (same-origin BFF; never expose via NEXT_PUBLIC_*)
# Browser clients always use relative /api/v1 (Next rewrite). Do not set NEXT_PUBLIC_API_BASE_URL
# to http://localhost:3001 — that bypasses the BFF cookie chain and can drop the /api/v1 prefix.
INTERNAL_API_BASE_URL=http://127.0.0.1:3001/api/v1
DATABASE_URL=postgresql://weight_app:weight_app_local@localhost:5432/weight_app
REDIS_URL=redis://localhost:6379
EXPORT_STORAGE_ROOT=

# secret — generate unique local values; documented fallbacks allowed only for LOCAL dev
AUTH_SESSION_SECRET=local-dev-session-secret-min-32-chars-xx
AUTH_REFRESH_SECRET=local-dev-refresh-secret-min-32-chars-xx
AUTH_ABUSE_HASH_SECRET=local-dev-abuse-hash-secret-min-32-ch
PLAN_REVISION_CONFIRMATION_SECRET=local-plan-revision-secret-32-chars
EXPORT_SIGNING_SECRET=local-export-signing-secret-32-chars
AUTH_MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# server — local object storage (optional external placeholders)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# public/server
AI_PROVIDER=local

# local-only bootstrap (one-shot; not part of compose startup)
OWNER_BOOTSTRAP_ENABLED=false

# release-metadata (LOCAL image builds)
RELEASE_VERSION=0.0.0-local
RELEASE_GIT_SHA=local
