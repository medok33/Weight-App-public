# syntax=docker/dockerfile:1.7
# weight-app-web — Next.js standalone production image
ARG NODE_VERSION=22.17

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/domain/package.json packages/domain/
COPY packages/observability/package.json packages/observability/
COPY packages/testing/package.json packages/testing/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile --filter web...

FROM base AS build
COPY --from=deps /app /app
COPY . .
# Standalone Next build; do not bake browser API host into the bundle.
# Compose services reach Nest as hostname `api` (runtime BFF also reads INTERNAL_*).
ENV NEXT_TELEMETRY_DISABLED=1 \
    INTERNAL_API_BASE_URL=http://api:3001/api/v1 \
    API_BASE_URL=http://api:3001/api/v1
RUN pnpm --filter web build

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ARG RELEASE_VERSION=0.0.0-local
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown
ARG OCI_SOURCE=

LABEL org.opencontainers.image.title="weight-app-web" \
      org.opencontainers.image.description="Weight App Next.js web + BFF" \
      org.opencontainers.image.version="${RELEASE_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_TIMESTAMP}" \
      org.opencontainers.image.source="${OCI_SOURCE}"

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    APP_HOME=/app

WORKDIR /app

RUN groupadd --system --gid 10001 weightapp \
 && useradd --system --uid 10001 --gid weightapp --home-dir /app --shell /usr/sbin/nologin weightapp

# Standalone server + static assets
COPY --from=build --chown=weightapp:weightapp /app/apps/web/.next/standalone ./
COPY --from=build --chown=weightapp:weightapp /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=weightapp:weightapp /app/apps/web/public ./apps/web/public

USER weightapp:weightapp
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
