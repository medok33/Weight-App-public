# syntax=docker/dockerfile:1.7
# weight-app-api + migrate one-shot targets
# Note: PrismaService is a pg Pool wrapper; there is no @prisma/client generate step.
ARG NODE_VERSION=22.17

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/domain/package.json packages/domain/
COPY packages/observability/package.json packages/observability/
COPY packages/testing/package.json packages/testing/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile --filter api...

FROM base AS build
COPY --from=deps /app /app
COPY . .
RUN pnpm --filter api build \
 && pnpm --filter api deploy --prod --legacy /out/api

FROM node:${NODE_VERSION}-bookworm-slim AS runtime-base
ARG RELEASE_VERSION=0.0.0-local
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown
ARG OCI_SOURCE=

LABEL org.opencontainers.image.title="weight-app-api" \
      org.opencontainers.image.description="Weight App NestJS API" \
      org.opencontainers.image.version="${RELEASE_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_TIMESTAMP}" \
      org.opencontainers.image.source="${OCI_SOURCE}"

ENV NODE_ENV=production \
    PORT=3001 \
    APP_HOME=/app

WORKDIR /app

RUN groupadd --system --gid 10001 weightapp \
 && useradd --system --uid 10001 --gid weightapp --home-dir /app --shell /usr/sbin/nologin weightapp \
 && mkdir -p /app/data /tmp/weight-app \
 && chown -R weightapp:weightapp /app /tmp/weight-app

COPY --from=build --chown=weightapp:weightapp /out/api/ ./
COPY --from=build --chown=weightapp:weightapp /app/apps/api/dist ./dist
COPY --from=build --chown=weightapp:weightapp /app/apps/api/scripts ./scripts
COPY --from=build --chown=weightapp:weightapp /app/apps/api/prisma ./prisma
# migrate.mjs lives at /app/scripts/migrate.mjs and imports
# ../../../scripts/verify/disposable-runtime.mjs, which resolves to
# /scripts/verify/disposable-runtime.mjs (not /app/scripts/verify/...).
# Copy the guard + its local helper to that exact resolved path.
RUN mkdir -p /scripts/verify \
 && chown -R weightapp:weightapp /scripts
COPY --from=build --chown=weightapp:weightapp /app/scripts/verify/disposable-runtime.mjs /scripts/verify/disposable-runtime.mjs
COPY --from=build --chown=weightapp:weightapp /app/scripts/verify/orchestration.mjs /scripts/verify/orchestration.mjs
COPY --from=build --chown=weightapp:weightapp /app/scripts/verify/web-dependency-topology.mjs /scripts/verify/web-dependency-topology.mjs

USER weightapp:weightapp

# ----- API runtime -----
FROM runtime-base AS api
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/v1/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# API must NOT auto-migrate. Migrations are a separate one-shot job.
CMD ["node", "dist/main.js"]

# ----- Migration one-shot (same release artifact) -----
FROM runtime-base AS migrate
LABEL org.opencontainers.image.title="weight-app-migrate" \
      org.opencontainers.image.description="Weight App SQL migration job (SchemaMigrationLedger)"
USER weightapp:weightapp
# Fail non-zero on error; exit 0 after apply/skip. No secrets in stdout beyond counts.
CMD ["node", "scripts/migrate.mjs"]
